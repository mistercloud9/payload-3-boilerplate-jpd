{\n  \"name\": \"payload-3-boilerplate\",\n  \"version\": \"1.0.0\",\n  \"description\": \"Payload V3 Website builder boilerplate for Railway\",\n  \"license\": \"MIT\",\n  \"type\": \"module\",\n  \"scripts\": {\n    \"build\": \"payload generate:importmap && cross-env NODE_OPTIONS=--no-deprecation next build\",\n    \"deps:native\": \"corepack pnpm rebuild sharp esbuild\",\n    \"dev\": \"cross-env NODE_OPTIONS=--no-deprecation next dev\",\n    \"dev:prod\": \"cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start\",\n    \"e2e:install\": \"corepack pnpm install && corepack pnpm deps:native && corepack pnpm exec playwright install chromium\",\n    \"generate:importmap\": \"cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap\",\n    \"generate:types\": \"cross-env NODE_OPTIONS=--no-deprecation payload generate:types\",\n    \"ii\": \"cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install\",\n    \"lint\": \"cross-env NODE_OPTIONS=--no-deprecation eslint .\",\n    \"lint:fix\": \"cross-env NODE_OPTIONS=--no-deprecation eslint . --fix\",\n    \"payload\": \"cross-env NODE_OPTIONS=--no-deprecation payload\",\n    \"reinstall\": \"cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install\",\n    \"start\": \"cross-env NODE_OPTIONS=--no-deprecation next start\",\n    \"test:e2e\": \"playwright test\",\n    \"test:e2e:headed\": \"playwright test --headed\",\n    \"test:e2e:manual\": \"cross-env PLAYWRIGHT_SLOW_MO=750 E2E_MANUAL_REVIEW=true playwright test --headed --workers=1\"\n  },\n  \"dependencies\": {\n    \"@payloadcms/db-postgres\": \"3.88.0\",\n    \"@payloadcms/live-preview-react\": \"3.88.0\",\n    \"@payloadcms/next\": \"3.88.0\",\n    \"@payloadcms/plugin-form-builder\": \"3.88.0\",\n    \"@payloadcms/plugin-nested-docs\": \"3.88.0\",\n    \"@payloadcms/plugin-redirects\": \"3.88.0\",\n    \"@payloadcms/plugin-search\": \"3.88.0\",\n    \"@payloadcms/plugin-seo\": \"3.88.0\",\n    \"@payloadcms/richtext-lexical\": \"3.88.0\",\n    \"@payloadcms/ui\": \"3.88.0\",\n    \"@radix-ui/react-checkbox\": \"^1.3.6\",\n    \"@radix-ui/react-label\": \"^2.1.11\",\n    \"@radix-ui/react-select\": \"^2.3.2\",\n    \"@radix-ui/react-slot\": \"^1.3.0\",\n    \"class-variance-authority\": \"^0.7.1\",\n    \"clsx\": \"^2.1.1\",\n    \"cross-env\": \"^7.0.3\",\n    \"geist\": \"^1.7.2\",\n    \"graphql\": \"^16.14.0\",\n    \"jsonwebtoken\": \"9.0.3\",\n    \"lucide-react\": \"^1.14.0\",\n    \"next\": \"16.3.1\",\n    \"payload\": \"3.88.0\",\n    \"payload-admin-bar\": \"^1.0.7\",\n    \"prism-react-renderer\": \"^2.4.1\",\n    \"react\": \"^19.2.8\",\n    \"react-dom\": \"^19.2.8\",\n    \"react-hook-form\": \"7.75.0\",\n    \"sharp\": \"0.35.3\",\n    \"tailwind-merge\": \"^3.6.0\",\n    \"tailwindcss-animate\": \"^1.0.7\"\n  },\n  \"devDependencies\": {\n    \"@next/eslint-plugin-next\": \"16.3.1\",\n    \"@playwright/test\": \"^1.62.1\",\n    \"@tailwindcss/typography\": \"^0.5.20\",\n    \"@types/escape-html\": \"^1.0.4\",\n    \"@types/jsonwebtoken\": \"^9.0.10\",\n    \"@types/node\": \"22.18.0\",\n    \"@types/react\": \"^19.2.18\",\n    \"@types/react-dom\": \"^19.2.4\",\n    \"autoprefixer\": \"^10.5.4\",\n    \"eslint\": \"^9.39.1\",\n    \"eslint-config-next\": \"16.3.1\",\n    \"postcss\": \"^8.5.26\",\n    \"prettier\": \"^3.9.6\",\n    \"tailwindcss\": \"^3.4.16\",\n    \"typescript\": \"5.7.2\"\n  },\n  \"engines\": {\n    \"node\": \"^18.20.2 || >=20.9.0\"\n  },\n  \"pnpm\": {\n    \"onlyBuiltDependencies\": [\n      \"esbuild\",\n      \"sharp\"\n    ]\n  },\n  \"packageManager\": \"pnpm@10.26.0\"\n}\n
